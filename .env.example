# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olist_bi
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Application Configuration
APP_ENV=development
DATA_DIR=Brazilian E-Commerce Public Dataset
DB_BACKEND=duckdb  # Options: 'duckdb' (zero-setup embedded) or 'postgresql'
DUCKDB_PATH=data/processed/ecommerce_bi.duckdb
LOG_LEVEL=INFO
